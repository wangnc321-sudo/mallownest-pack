  {
   "id": "snack",
   "name": "原版・要點心",
   "tag": "MEOW",
   "q": [
    "Hey hooman!",
    "Can I have a snack?"
   ],
   "a": [
    "YES!",
    "OF COURSE!"
   ]
  },
  {
   "id": "rent",
   "name": "房東收租",
   "tag": "LANDLORD",
   "q": [
    "Your rent is due.",
    "I accept treats."
   ],
   "a": [
    "PAY UP",
    "MORE TREATS"
   ]
  },
  {
   "id": "cup",
   "name": "打翻杯子",
   "tag": "OOPS",
   "q": [
    "I knocked your cup",
    "off the table."
   ],
   "a": [
    "WHY?!",
    "IT WAS ART"
   ]
  },
  {
   "id": "zoom",
   "name": "半夜暴衝",
   "tag": "ZOOMIES",
   "q": [
    "It's 3AM. Perfect",
    "time to sprint!"
   ],
   "a": [
    "PLEASE NO",
    "ZZZ..."
   ]
  },
  {
   "id": "empty",
   "name": "碗空了",
   "tag": "HANGRY",
   "q": [
    "My bowl is EMPTY!",
    "I see the BOTTOM!"
   ],
   "a": [
    "REFILL",
    "IT'S FULL..."
   ]
  },
  {
   "id": "bowl",
   "name": "碗沒全滿",
   "tag": "HANGRY",
   "q": [
    "My bowl is only",
    "90% full. HELP!"
   ],
   "a": [
    "REFILL",
    "CALL 911"
   ]
  },
